# Multi-stage hardened non-root container for Frontend & Nginx Proxy
# Stage 1: Build static assets
FROM node:22-alpine AS builder

WORKDIR /app

# Install build dependencies
COPY package.json package-lock.json ./
COPY packages/contracts/package.json ./packages/contracts/
COPY frontend/package.json ./frontend/

RUN npm ci

# Copy source code
COPY tsconfig.base.json ./
COPY packages/contracts/ ./packages/contracts/
COPY frontend/ ./frontend/

# Build contracts and frontend static distribution
RUN npm run build --workspace=@text2sql/contracts
RUN npm run build --workspace=@text2sql/frontend

# ==========================================
# Stage 2: Unprivileged Nginx Web Server
# ==========================================
FROM nginxinc/nginx-unprivileged:alpine AS runner

# Copy custom unprivileged nginx configuration
COPY infra/nginx/nginx.conf /etc/nginx/nginx.conf

# Copy compiled frontend static assets
COPY --from=builder /app/frontend/dist /usr/share/nginx/html

EXPOSE 8080

USER 101

CMD ["nginx", "-g", "daemon off;"]

