# Server Configuration
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Security & Session (minimum 32 characters)
SESSION_SECRET=your_dev_session_secret_min_32_characters_here

# Database Connections (Dual PostgreSQL topology on loopback port 5434)
ANALYTICS_DB_URL=postgresql://analytics_user:your_analytics_password@127.0.0.1:5434/analytics_db
APP_DB_URL=postgresql://app_user:your_app_password@127.0.0.1:5434/app_db
