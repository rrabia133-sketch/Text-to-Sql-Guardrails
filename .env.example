# Server Configuration
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Security & Session (minimum 32 characters)
SESSION_SECRET=dev-session-secret-change-in-production-min-32-chars

# Database Connections (Dual PostgreSQL topology on loopback port 5434)
ANALYTICS_DB_URL=postgresql://analytics_user:analytics_password@127.0.0.1:5434/analytics_db
APP_DB_URL=postgresql://app_user:app_password@127.0.0.1:5434/app_db
