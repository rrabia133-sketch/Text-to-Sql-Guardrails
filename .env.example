# Server Configuration
PORT=3001
HOST=127.0.0.1
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Security & Session (minimum 32 characters)
SESSION_SECRET=your_dev_session_secret_min_32_characters_here

# Database Connections (Dual PostgreSQL topology on loopback port 5434)
ANALYTICS_DB_URL=postgresql://analytics_user:your_analytics_password@127.0.0.1:5434/analytics_db
APP_DB_URL=postgresql://app_user:your_app_password@127.0.0.1:5434/app_db
MIGRATION_DB_URL=postgresql://db_migrator:your_migrator_password@127.0.0.1:5434/app_db

# LLM Provider Configuration (US-08 / DO-05)
PROVIDER_MODE=local
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5-coder:7b
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
DAILY_CLOUD_BUDGET_USD=5.00
GENERATION_TIMEOUT_LOCAL_MS=30000
GENERATION_TIMEOUT_CLOUD_MS=15000

# Analytics Timezone (US-05)
ANALYTICS_TIMEZONE=UTC
