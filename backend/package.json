{
    "name": "@text2sql/backend",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "main": "./dist/server.js",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc",
        "typecheck": "tsc --noEmit",
