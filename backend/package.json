        "@fastify/cors": "^10.0.2",
        "@fastify/sensible": "^6.0.3",
        "@text2sql/contracts": "*",
        "dotenv": "^16.4.7",
        "fastify": "^5.2.1",
        "pg": "^8.23.1"
    },
    "devDependencies": {
        "@types/node": "^22.13.1",
        "@types/pg": "^8.23.1",
        "tsx": "^4.19.2",
        "typescript": "^5.6.0"
    }
